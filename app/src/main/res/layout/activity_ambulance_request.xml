<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REQUEST AMBULANCE"
            android:textColor="#123C46"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Enter your details and pickup location."
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPatientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Patient name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etPatientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact phone number"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etPickupLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pickup location / address"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/etEmergencyDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Emergency details"
            android:gravity="top"
            android:minLines="3"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnSubmitRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#D9232E"
            android:text="SUBMIT AMBULANCE REQUEST"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
