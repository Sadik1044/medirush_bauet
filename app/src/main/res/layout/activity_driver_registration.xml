<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F8F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DRIVER REGISTRATION"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#123C46"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply to become a Medirush ambulance driver."
            android:textSize="15sp"
            android:textColor="#60757B"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etDriverPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone number"
            android:inputType="phone"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etDriverLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driving licence number"
            android:inputType="textCapCharacters"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etDriverArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Service area / city"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSubmitDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUBMIT APPLICATION"
            android:layout_marginTop="28dp"
            android:minHeight="54dp"
            android:backgroundTint="#0D9488"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>